<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="QuestBankPinTemplate" mixin="QuestBankPinMixin" virtual="true" enableMouse="true">
    <Size x="22" y="22"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
      <Layer level="OVERLAY">
        <FontString parentKey="Num" inherits="NumberFontNormal" justifyH="CENTER">
          <Anchors>
            <Anchor point="BOTTOM" relativePoint="TOP" x="0" y="-4"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <!-- only OnLoad: the map canvas sets the mouse scripts itself and calls the mixin's
         OnMouseEnter, OnMouseLeave and OnMouseClickAction; a template that sets them trips its assert -->
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
  <!-- the quest icons (QuestMap.lua): ! where a quest starts, ? where one is handed in, a mark on an objective or
       where a quest item drops; sized and given their art when the map hands them out -->
  <Frame name="QuestBankQuestPinTemplate" mixin="QuestBankQuestPinMixin" virtual="true" enableMouse="true">
    <Size x="20" y="20"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
      <Layer level="OVERLAY">
        <Texture parentKey="Badge" hidden="true">
          <Size x="10" y="10"/>
          <Anchors>
            <Anchor point="TOPRIGHT" x="3" y="3"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
  <!-- an objective's area: a soft disc that grows and shrinks with the map. No mouse: the mark on it has the tooltip -->
  <Frame name="QuestBankAreaPinTemplate" mixin="QuestBankAreaPinMixin" virtual="true" enableMouse="false">
    <Size x="32" y="32"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Circle" setAllPoints="true"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
