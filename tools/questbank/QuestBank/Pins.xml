<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- QuestBank's own frames on the world map's canvas: Pins.lua makes them out of combat, places and scales them, and
       sets their mouse scripts. They are never the map canvas's pins (no mixin or scripts here, nothing the canvas
       hands out): Pins.lua says why. -->
  <!-- a numbered route pin, or a ! where a quest you plan to fetch starts -->
  <Frame name="QuestBankPinTemplate" virtual="true" enableMouse="true">
    <Size x="22" y="22"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
      <Layer level="OVERLAY">
        <FontString parentKey="Num" inherits="NumberFontNormal" justifyH="CENTER">
          <Anchors>
            <Anchor point="BOTTOM" relativePoint="TOP" x="0" y="-4"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
  <!-- the quest icons (QuestMap.lua): ! where a quest starts, ? where one is handed in, a mark on an objective or
       where a quest item drops; sized and given their art when drawn -->
  <Frame name="QuestBankQuestPinTemplate" virtual="true" enableMouse="true">
    <Size x="20" y="20"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon" setAllPoints="true"/>
      </Layer>
      <Layer level="OVERLAY">
        <Texture parentKey="Badge" hidden="true">
          <Size x="10" y="10"/>
          <Anchors>
            <Anchor point="TOPRIGHT" x="3" y="3"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
  </Frame>
  <!-- an objective's area: a soft disc as big as the ground it covers. No mouse: the mark on it has the tooltip -->
  <Frame name="QuestBankAreaPinTemplate" virtual="true" enableMouse="false">
    <Size x="32" y="32"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Circle" setAllPoints="true"/>
      </Layer>
    </Layers>
  </Frame>
</Ui>
